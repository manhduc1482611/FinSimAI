# ═══════════════════════════════════════════════════════════════════════════════
# Cấu hình Frontend FinSimAI (Next.js) — Dùng cho Dev và Production (Vercel)
# ═══════════════════════════════════════════════════════════════════════════════

# 1. Backend chính trên Render (FastAPI + WebSocket + AI Engine + Database)
NEXT_PUBLIC_API_URL=https://<TEN_SERVICE_RENDER>.onrender.com
# NEXT_PUBLIC_WS_URL=wss://<TEN_SERVICE_RENDER>.onrender.com  # Tùy chọn, tự suy từ API_URL

# 2. Backend dự phòng / chia tải trên Google Apps Script (Serverless Sheets DB)
# Lấy từ Google Apps Script > Deploy > New deployment > Web app > Exec URL
NEXT_PUBLIC_SS_API_URL=https://script.google.com/macros/s/<DEPLOYMENT_ID>/exec

# 3. Chế độ Dual-Backend Failover tự động (Render <-> Apps Script):
# - Tự động bật khi khai báo cả 2 URL ở trên.
# - Nếu Render đang ngủ/cold start/quá tải (502, 503, 504, 429) → tự chuyển sang Apps Script.
# - Nếu Apps Script quá hạn ngạch (429 Quota Exceeded) → tự chuyển về Render.
# - Biểu đồ giá tự động chuyển sang Polling khi Render WebSocket chưa thức giấc.
NEXT_PUBLIC_FAILOVER_ENABLED=true

# Ưu tiên backend nào làm nguồn chính (mặc định: render; hoặc appscript)
NEXT_PUBLIC_PRIMARY_BACKEND=render

# ---------------------------------------------------------------------------
# DEMO MODE ĐƠN LẺ (chỉ dùng nếu muốn chạy duy nhất Apps Script, không cần Render):
# NEXT_PUBLIC_DEMO_MODE=true
