# Cấu hình frontend — copy thành .env.local
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ---------------------------------------------------------------------------
# DEMO MODE (tùy chọn) — dùng Google Apps Script làm backend, KHÔNG cần FastAPI.
# BẬT demo mode thì BẮT BUỘC khai báo URL web app của Apps Script; không có URL
# mặc định nào cả (thiếu URL → request báo lỗi, không gọi backend lạ).
#
# NEXT_PUBLIC_DEMO_MODE=true
# NEXT_PUBLIC_SS_API_URL=https://script.google.com/macros/s/<DEPLOYMENT_ID>/exec
