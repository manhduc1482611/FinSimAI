{
  "name": "finsim-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "FinSimAI — Web UI (Next.js 14 App Router + TailwindCSS + Zustand)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:console": "node ../../scripts/console-test.mjs",
    "test:console:stale": "node ../../scripts/console-test.mjs --token=stale.invalid.token"
  },
  "dependencies": {
    "@finsim/shared-types": "*",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@types/three": "^0.185.4",
    "lightweight-charts": "^5.2.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "^0.186.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.35",
    "firebase-tools": "^14.0.0",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.6.3"
  }
}
