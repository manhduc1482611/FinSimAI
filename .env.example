# ─── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://finsim:finsim_secret@localhost:5432/finsimai
DATABASE_URL_SYNC=postgresql://finsim:finsim_secret@localhost:5432/finsimai

# ─── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Auth / Security ──────────────────────────────────────
JWT_SECRET=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── AI / LLM ─────────────────────────────────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=

# ─── News Sources ─────────────────────────────────────────
NEWS_API_KEY=

# ─── CORS ─────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]
# Regex bổ sung cho origin (Vercel Preview: https://.*\.vercel\.app) — để trống nếu không dùng.
CORS_ORIGIN_REGEX=

# ─── Frontend ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Internal Services ────────────────────────────────────
MATH_ENGINE_GRPC_HOST=localhost
MATH_ENGINE_GRPC_PORT=50051
AI_ENGINE_URL=http://localhost:8001

# ─── Next.js Public ───────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ─── App ──────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ─── Production ────────────────────────────────────────────
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/<db>
# DIRECT_URL=postgresql://<user>:<password>@<direct-host>:5432/<db>
# DATABASE_URL_SYNC=postgresql://<user>:<password>@<direct-host>:5432/<db>
# REDIS_URL=rediss://<user>:<password>@<upstash-host>:6379/0
# JWT_SECRET=<random-secret-at-least-32-chars>
# GEMINI_API_KEY=<your-gemini-api-key>
# NEXT_PUBLIC_API_URL=https://<your-backend-url>
# NEXT_PUBLIC_WS_URL=wss://<your-backend-url>
# CORS_ORIGINS=https://your-app.vercel.app
# FRONTEND_URL=https://your-app.vercel.app
# MATH_ENGINE_GRPC_HOST=math-engine
# AI_ENGINE_URL=https://<your-ai-engine-api-url>

# ─── CI/CD Secrets (GitHub Actions) ───────────────────────
# FIREBASE_SERVICE_ACCOUNT=<firebase-service-account-json>
# FIREBASE_PROJECT_ID=finsimai-web
# GCP_PROJECT_ID=<your-gcp-project-id>
# GCP_REGION=asia-southeast1
# GCP_SA_KEY=<gcp-service-account-json>
# RENDER_API_KEY=<render-api-key>
