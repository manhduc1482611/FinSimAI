# ─── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://finsim:finsim_secret@localhost:5432/finsimai
DATABASE_URL_SYNC=postgresql://finsim:finsim_secret@localhost:5432/finsimai

# ─── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Auth / Security ──────────────────────────────────────
JWT_SECRET=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── AI / LLM ─────────────────────────────────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=
# Model routing — tối ưu chi phí / latency theo agent:
#   GEMINI_MODEL       : default (Flash) — judge, grounding, intent LLM layer
#   GEMINI_MENTOR_MODEL: Socratic Mentor — context dài, suy luận giáo dục (Pro)
#   GEMINI_FAST_MODEL  : routing/NER cực nhẹ (Flash, có thể đổi Flash-8B)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MENTOR_MODEL=gemini-2.5-pro
GEMINI_FAST_MODEL=gemini-2.5-flash
# Rate limit — token bucket phân tán qua Redis (shared giữa các worker/instance).
# Mỗi model tier có bucket Redis riêng: ratelimit:gemini-pro:* và ratelimit:gemini-flash:*
# Pro (Socratic Mentor): quota thấp, giá cao — bảo vệ nghiêm ngặt hơn.
GEMINI_PRO_RATE_LIMIT_RPM=5       # Requests/phút cho Gemini Pro (Socratic Mentor)
GEMINI_PRO_RATE_LIMIT_BURST=3     # Burst capacity tối đa cho Pro
# Flash (Intent, Concept, Strategy, Scenario worker): quota cao hơn.
GEMINI_FLASH_RATE_LIMIT_RPM=30    # Requests/phút cho Gemini Flash
GEMINI_FLASH_RATE_LIMIT_BURST=10  # Burst capacity tối đa cho Flash
# Thời gian tối đa chờ token trước khi trả RateLimitExceeded (áp dụng cho cả Pro và Flash).
GEMINI_RATE_LIMIT_MAX_WAIT_SECONDS=90

# ─── News Sources ─────────────────────────────────────────
NEWS_API_KEY=

# ─── CORS ─────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]
# Regex bổ sung cho origin (Vercel Preview: https://.*\.vercel\.app) — để trống nếu không dùng.
CORS_ORIGIN_REGEX=

# ─── Frontend ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Internal Services ────────────────────────────────────
# Backend Gateway gọi Math Engine qua HTTP (không còn gRPC).
MATH_ENGINE_URL=http://localhost:8000
# Backend Gateway gọi AI Engine (mentor). Chỉ gọi Gemini khi MENTOR_LLM_MODE=on.
AI_ENGINE_URL=http://localhost:8001
MENTOR_LLM_MODE=off
# AI Engine đẩy nội dung về Backend Gateway (/api/v1/ai/content).
BACKEND_GATEWAY_URL=http://localhost:8000
# Shared secret giữa 3 service (backend-gateway, math-engine, ai-engine-api).
# Production thiếu biến này → Math Engine/AI Engine từ chối request (fail-closed).
INTERNAL_API_KEY=dev-internal-key

# ─── Next.js Public ───────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ─── App ──────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
# Uvicorn chỉ tin X-Forwarded-For từ các IP này (mặc định 127.0.0.1). Sau proxy
# (Render/Vercel edge) đặt "*" để lấy IP thật của client cho rate-limit theo IP.
FORWARDED_ALLOW_IPS=127.0.0.1

# ─── Production ────────────────────────────────────────────
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/<db>
# DIRECT_URL=postgresql://<user>:<password>@<direct-host>:5432/<db>
# DATABASE_URL_SYNC=postgresql://<user>:<password>@<direct-host>:5432/<db>
# REDIS_URL=rediss://<user>:<password>@<upstash-host>:6379/0
# JWT_SECRET=<random-secret-at-least-32-chars>
# GEMINI_API_KEY=<your-gemini-api-key>
# NEXT_PUBLIC_API_URL=https://<your-backend-url>
# NEXT_PUBLIC_WS_URL=wss://<your-backend-url>
# CORS_ORIGINS=https://your-app.vercel.app
# FRONTEND_URL=https://your-app.vercel.app
# MATH_ENGINE_URL=https://<your-math-engine-url>
# AI_ENGINE_URL=https://<your-ai-engine-api-url>
# BACKEND_GATEWAY_URL=https://<your-backend-url>
# INTERNAL_API_KEY=<random-shared-secret>
# MENTOR_LLM_MODE=off

# ─── CI/CD Secrets (GitHub Actions) ───────────────────────
# FIREBASE_SERVICE_ACCOUNT=<firebase-service-account-json>
# FIREBASE_PROJECT_ID=finsimai-web
# GCP_PROJECT_ID=<your-gcp-project-id>
# GCP_REGION=asia-southeast1
# GCP_SA_KEY=<gcp-service-account-json>
# RENDER_API_KEY=<render-api-key>
