# ─── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://finsim:finsim_secret@localhost:5432/finsimai
DATABASE_URL_SYNC=postgresql://finsim:finsim_secret@localhost:5432/finsimai

# ─── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Auth / Security ──────────────────────────────────────
JWT_SECRET=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── AI / LLM ─────────────────────────────────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=

# ─── News Sources ─────────────────────────────────────────
NEWS_API_KEY=

# ─── App ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
ENVIRONMENT=development
DEBUG=true
