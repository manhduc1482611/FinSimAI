# ═══════════════════════════════════════════════════════════════════════════════
# FinSimAI — Production Environment Template
# Copy to .env và điền giá trị thực tế trước khi deploy lên Vercel / Render.
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# [SUPABASE / POSTGRESQL]
# ─────────────────────────────────────────────────────────────────────────────
# Connection string cho SQLAlchemy async engine (Supabase Connection Pooler).
# Dùng cho runtime queries trên Backend Gateway.
DATABASE_URL=postgresql+asyncpg://<YOUR_SUPABASE_USER>:<YOUR_SUPABASE_PASSWORD>@<YOUR_SUPABASE_HOST>:5432/<YOUR_DB_NAME>
# Connection string cho sync engine (dùng cho Alembic migrations / Supabase SQL editor).
# Đây chính là DIRECT_URL từ dashboard Supabase.
DIRECT_URL=postgresql://<YOUR_SUPABASE_USER>:<YOUR_SUPABASE_PASSWORD>@<YOUR_SUPABASE_DIRECT_HOST>:5432/<YOUR_DB_NAME>
# Sync database URL (alias cho DIRECT_URL, dùng bởi alembic).
DATABASE_URL_SYNC=postgresql://<YOUR_SUPABASE_USER>:<YOUR_SUPABASE_PASSWORD>@<YOUR_SUPABASE_DIRECT_HOST>:5432/<YOUR_DB_NAME>

# ─────────────────────────────────────────────────────────────────────────────
# [UPSTASH REDIS]
# ─────────────────────────────────────────────────────────────────────────────
# Upstash Redis REST endpoint (cổng TCP).
# Dùng cho: ARQ worker, cache WebSocket tickets, backplane realtime.
REDIS_URL=rediss://<YOUR_UPSTASH_REDIS_USER>:<YOUR_UPSTASH_REDIS_PASSWORD>@<YOUR_UPSTASH_REDIS_HOST>:6379/0

# ─────────────────────────────────────────────────────────────────────────────
# [GEMINI AI]
# ─────────────────────────────────────────────────────────────────────────────
# Google Gemini API key (dùng bởi AI Engine — mentor, news insight, scenario gen).
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>

# ─────────────────────────────────────────────────────────────────────────────
# [BACKEND GATEWAY & CORS]
# ─────────────────────────────────────────────────────────────────────────────
# Secret dùng để ký JWT — dùng một chuỗi ngẫu nhiên >= 32 ký tự.
JWT_SECRET=<your-random-jwt-secret-at-least-32-chars>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Allow Origins — phân tách bằng dấu phẩy, PHẢI bao gồm domain Vercel.
# Ví dụ: https://finsimai.vercel.app,https://www.finsimai.vercel.app
CORS_ORIGINS=https://finsimai.vercel.app

# (Tùy chọn) Regex cho phép mọi origin khớp pattern — dùng cho Vercel Preview
# deploy (subdomain thay đổi mỗi PR). Ví dụ: CORS_ORIGIN_REGEX=https://.*\.vercel\.app
# CORS_ORIGIN_REGEX=

# Frontend URL (dùng cho redirect, callbacks, CORS documentation).
FRONTEND_URL=https://finsimai.vercel.app

# ─────────────────────────────────────────────────────────────────────────────
# [INTERNAL SERVICES]
# ─────────────────────────────────────────────────────────────────────────────
# Host nội bộ của Math Engine gRPC server (trên Render: private service name).
MATH_ENGINE_GRPC_HOST=math-engine
MATH_ENGINE_GRPC_PORT=50051

# URL của AI Engine API service (trên Render: https://ai-engine-api.onrender.com).
# Được Backend Gateway gọi để enqueue task hoặc lấy kết quả AI.
AI_ENGINE_URL=https://ai-engine-api.onrender.com

# ─────────────────────────────────────────────────────────────────────────────
# [NEXT.PUBLIC FRONTEND]  — thiết lập trên Vercel Dashboard
# ─────────────────────────────────────────────────────────────────────────────
# API Gateway URL (Render backend-gateway web service).
NEXT_PUBLIC_API_URL=https://backend-gateway.onrender.com
# WebSocket base URL (Render backend-gateway WS endpoint, bắt đầu bằng wss://).
NEXT_PUBLIC_WS_URL=wss://backend-gateway.onrender.com

# ─────────────────────────────────────────────────────────────────────────────
# [GENERAL]
# ─────────────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
